# SiteSentry Backend Environment Configuration
PORT=5001

# Persistent MongoDB Connection String
# For persistent storage across server restarts, supply a MongoDB Atlas or local MongoDB URI.
# If unset or unreachable, SiteSentry starts an embedded in-memory MongoDB (ephemeral/volatile: audits reset on restart).
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sitesentry?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated, optional)
# In production on Render, set this to your Vercel frontend URL:
# CORS_ORIGIN=https://sitesentry-frontend.vercel.app

# Google Gemini API Key (Optional - for AI Executive Brief & Fix Generator)
# If unset, SiteSentry automatically falls back to deterministic rule-based recommendations.
# GEMINI_API_KEY=your_gemini_api_key_here
