# SiteSentry Backend Environment Configuration
PORT=5001

# MongoDB Connection String (Optional)
# If left commented or empty, SiteSentry automatically initializes a zero-config embedded MongoDB engine!
# MONGODB_URI=mongodb://localhost:27017/sitesentry

# Google Gemini API Key (Optional - for AI Executive Brief & Fix Generator)
# Obtain a free API key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
